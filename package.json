{
    "name": "navichrome",
    "type": "module",
    "version": "0.1.0-beta.1",
    "description": "Navichrome, a self-hosted web player for Navidrome and OpenSubsonic servers",
    "scripts": {
        "dev": "vite",
        "test": "npm run test:navidrome && npm run test:unit && npm run test:smoke",
        "test:navidrome": "vitest run js/navidrome-api.test.ts --config=vite.config.ts --browser.enabled=false --environment=node",
        "test:unit": "vitest run js/navichrome-core.test.js --config=vite.config.ts --browser.enabled=false --environment=node",
        "test:smoke": "npm run build && playwright test",
        "test:watch": "vitest --config=vite.config.ts --browser.enabled=false",
        "install:playwright": "playwright install chromium",
        "build": "vite build",
        "audit:bundle": "node scripts/audit-bundle.mjs",
        "preview": "vite preview",
        "lint:js": "eslint .",
        "lint:css": "stylelint \"**/*.css\"",
        "lint:html": "htmlhint \"**/*.html\" --ignore=\"dist/**,legacy/**,node_modules/**\"",
        "lint": "npm run lint:js && npm run lint:css && npm run lint:html",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lhci": "lhci",
        "lhci:autorun": "npm run build && lhci autorun"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/lozza/monochrome-navidrome.git"
    },
    "keywords": [
        "music"
    ],
    "author": "",
    "license": "Apache-2.0",
    "bugs": {
        "url": "https://github.com/lozza/monochrome-navidrome/issues"
    },
    "homepage": "https://github.com/lozza/monochrome-navidrome#readme",
    "devDependencies": {
        "@lhci/cli": "^0.14.0",
        "@types/node": "^25.3.5",
        "@vitest/browser-playwright": "^4.1.2",
        "eslint": "^9.39.3",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.4.0",
        "htmlhint": "^1.9.2",
        "playwright": "^1.58.2",
        "prettier": "^3.8.1",
        "stylelint": "^16.26.1",
        "stylelint-config-standard": "^39.0.1",
        "typescript": "^5.9.3",
        "vite": "^7.3.1",
        "vite-plugin-pwa": "^1.2.0"
    },
    "overrides": {
        "sourcemap-codec": "^1.4.14",
        "source-map": "^0.7.4",
        "serialize-javascript": "^7.0.3"
    },
    "dependencies": {
        "@dantheman827/taglib-ts": "^0.1.5",
        "@ffmpeg/core": "^0.12.10",
        "@ffmpeg/ffmpeg": "^0.12.15",
        "@ffmpeg/util": "^0.12.2",
        "@kawarp/core": "^1.1.1",
        "@types/wicg-file-system-access": "^2023.10.7",
        "butterchurn": "^2.6.7",
        "client-zip": "^2.5.0",
        "fuse.js": "^7.1.0",
        "hls.js": "^1.6.15",
        "lucide-static": "^0.577.0",
        "mime": "^4.1.0",
        "shaka-player": "^5.0.7",
        "svgo": "^4.0.1",
        "typescript-eslint": "^8.57.2",
        "uuid": "^13.0.0",
        "vitest": "^4.1.2"
    }
}
